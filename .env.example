# ScamTrace Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Database connection string
# For PostgreSQL (Docker / Managed Postgres):
# DATABASE_URL="postgresql://scamtrace:scamtrace_dev_password@localhost:5432/scamtrace_db?schema=public"
# For local zero-config SQLite mode (or Prisma local dev):
DATABASE_URL="file:./dev.db"

# Authentication & Session Security (minimum 32 characters)
SESSION_SECRET="scamtrace-enterprise-session-secret-key-2026-dev-only"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENVIRONMENT_LABEL="Demo Workspace"

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_ANALYZE_MAX="30"
RATE_LIMIT_WINDOW_MS="60000"

# File Upload / Evidence Vault Settings
MAX_EVIDENCE_SIZE_BYTES="5242880"
EVIDENCE_STORAGE_MODE="metadata-local"

